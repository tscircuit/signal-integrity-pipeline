{
  "name": "@tscircuit/signal-integrity-pipeline",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/signal-integrity-pipeline.git"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "fetch:vendor-models": "bun scripts/fetch-vendor-models.ts",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/fix-dist-imports.mjs && node scripts/bundle.mjs",
    "prepack": "npm run build",
    "test:package": "node --import tsx scripts/test-package.mjs",
    "check:modules": "bun scripts/check-modules.ts",
    "check:vocabulary": "bun scripts/check-vocabulary.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix"
  },
  "dependencies": {
    "@flatten-js/core": "1.6.14",
    "@noble/hashes": "1.8.0",
    "@stdlib/math-base-special-atan": "0.2.4",
    "@stdlib/math-base-special-ln": "0.2.5",
    "@stdlib/math-base-special-log1p": "0.2.4",
    "@stdlib/math-base-special-sin": "0.3.1",
    "@stdlib/math-base-special-sinh": "0.2.4",
    "@tscircuit/circuit-json-util": "https://pkg.pr.new/tscircuit/circuit-json-util/@tscircuit/circuit-json-util@d22d831fdbacb9e130b288da4e0f9e06b57e203e",
    "@tscircuit/ibis-to-spice": "https://api.github.com/repos/tscircuit/ibis-to-spice/tarball/5feb4d02e4d6b1b6614e20e4f6fbdf9d2383f05b",
    "@tscircuit/solver-utils": "https://pkg.pr.new/tscircuit/solver-utils/@tscircuit/solver-utils@127f17012c7c391005254993864b26801f418249",
    "circuit-json-to-connectivity-map": "0.0.35",
    "format-si-unit": "0.0.12",
    "graphics-debug": "0.0.101",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@dagrejs/dagre": "3.1.3",
    "@resvg/resvg-js": "2.6.2",
    "@tscircuit/core": "0.0.2409",
    "@tscircuit/props": "0.0.735",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "circuit-json": "0.0.552",
    "circuit-json-to-gltf": "0.0.164",
    "circuit-to-svg": "0.0.454",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.3.15",
    "react": "19.2.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "@tscircuit/core": ">=0.0.2409",
    "@tscircuit/props": ">=0.0.735",
    "circuit-json": ">=0.0.552",
    "react": "^19.0.0"
  },
  "trustedDependencies": ["esbuild"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependenciesMeta": {
    "@tscircuit/core": {
      "optional": true
    },
    "@tscircuit/props": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
